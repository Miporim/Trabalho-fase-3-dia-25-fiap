{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "id",
    "nome",
    "volume"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "nome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "volume": {
      "type": "number",
      "minimum": 0,
      "exclusiveMinimum": true
    }
  },
  "additionalProperties": true
}